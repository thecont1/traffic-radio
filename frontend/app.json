{
  "expo": {
    "name": "Traffic Light",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070a0f",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.trafficlight"
    },
    "android": {
      "package": "com.emergent.trafficlight",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow this app to use your approximate location to show your neighbourhood under the signal light."
        }
      ]
    ]
  }
}
