{
  "expo": {
    "name": "Traffic Radio",
    "slug": "traffic-radio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070a0f",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.trafficradio"
    },
    "android": {
      "package": "com.emergent.trafficradio",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow this app to use your approximate location to show your neighbourhood under the signal light."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2288c9a7-0aef-4bac-b533-9f78c2db715e"
      }
    }
  },
  "extra": {
    "eas": {
      "projectId": "2288c9a7-0aef-4bac-b533-9f78c2db715e"
    }
  }
}
